{% from "template/_versions.jinja" import versions -%}
{
  "name": "client",
  "private": true,
  "version": "{{ versions.project }}",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "test": "bun test",
    "tauri": "tauri"{% if client_playwright %},
    "test:e2e": "playwright test"{% endif %}
  },
  "dependencies": {
    "@tauri-apps/api": "{{ versions.tauri }}",
    "@radix-ui/react-slot": "{{ versions.radix_react_slot }}",
    "class-variance-authority": "{{ versions.class_variance_authority }}",
    "clsx": "{{ versions.clsx }}",
    "react": "{{ versions.react }}",
    "react-dom": "{{ versions.react }}",
    "tailwind-merge": "{{ versions.tailwind_merge }}"{% if client_ai_sdk %},
    "ai": "{{ versions.ai }}",
    "zod": "{{ versions.zod }}"{% endif %}{% if client_tanstack_query %},
    "@tanstack/react-query": "{{ versions.tanstack_react_query }}"{% endif %}{% if client_i18next %},
    "i18next": "{{ versions.i18next }}",
    "react-i18next": "{{ versions.react_i18next }}"{% endif %}
  },
  "devDependencies": {
    "@biomejs/biome": "{{ versions.biome }}",
    "@happy-dom/global-registrator": "{{ versions.happy_dom }}",
    "@tailwindcss/vite": "{{ versions.tailwindcss }}",
    "@tauri-apps/cli": "{{ versions.tauri_cli }}",
    "@testing-library/dom": "{{ versions.testing_library_dom }}",
    "@testing-library/react": "{{ versions.testing_library_react }}",
    "@types/bun": "{{ versions.bun }}",
    "@types/react": "{{ versions.types_react }}",
    "@types/react-dom": "{{ versions.types_react_dom }}",
    "@vitejs/plugin-react": "{{ versions.vite_react }}",
    "tailwindcss": "{{ versions.tailwindcss }}",
    "typescript": "{{ versions.typescript }}",
    "vite": "{{ versions.vite }}"{% if client_playwright %},
    "@playwright/test": "{{ versions.playwright }}"{% endif %}
  }
}
