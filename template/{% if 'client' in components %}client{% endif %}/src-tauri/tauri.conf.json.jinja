{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": {{ project_name | tojson }},
  "version": "0.1.0",
  "identifier": "com.example.desktop-client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": {{ project_name | tojson }}, "width": 1000, "height": 700 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
