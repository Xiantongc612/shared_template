{% from "template/_versions.jinja" import versions -%}
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": {{ project_name | tojson }},
  "version": "{{ versions.project }}",
  "identifier": "com.example.desktop-client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": {{ project_name | tojson }}, "width": 1000, "height": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
