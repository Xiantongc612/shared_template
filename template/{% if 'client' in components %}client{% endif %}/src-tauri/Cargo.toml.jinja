{% from "template/_versions.jinja" import versions -%}
[package]
name = "desktop_client"
version = "{{ versions.project }}"
description = "Tauri desktop client"
edition = "2024"

[lib]
name = "desktop_client_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "={{ versions.tauri_build }}", features = [] }

[dependencies]
serde = { version = "={{ versions.serde }}", features = ["derive"] }
serde_json = "={{ versions.serde_json }}"
tauri = { version = "={{ versions.tauri }}", features = [] }
