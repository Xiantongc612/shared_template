import { afterEach, describe, expect, test } from "bun:test";
import { cleanup, render, screen } from "@testing-library/react";
{% if client_i18next -%}
import "./integrations/i18n";
{% endif -%}
import { App } from "./App";

afterEach(cleanup);

describe("App", () => {
  test("renders the desktop workspace", () => {
    render(<App />);
    expect(screen.getByRole("heading", { level: 1 })).toBeDefined();
  });
{% if client_ai_sdk %}
  test("loads the optional AI SDK without creating a model", async () => {
    const { aiSdkAvailable } = await import("./integrations/ai");

    expect(aiSdkAvailable).toBe(true);
  });
{% endif -%}
});
