import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parents[1]


def _run(*arguments: str) -> str:
    result = subprocess.run(
        [sys.executable, str(ROOT / "main.py"), *arguments],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout


def test_main_help_lists_mock_subcommands() -> None:
    output = _run("--help")

    assert "greet" in output
    assert "repeat" in output


def test_main_mock_greet() -> None:
    assert _run("greet", "--name", "integration") == "Hello, integration!\n"


def test_main_mock_repeat() -> None:
    assert _run("repeat", "hi", "--count", "3") == "hi\nhi\nhi\n"
