[project]
name = "fastapi-backend"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
    "fastapi==0.141.1",
    "uvicorn==0.52.1",
{% if fastapi_pydantic_ai %}    "pydantic-ai==2.22.0",
{% endif %}]

[dependency-groups]
dev = [
    "httpx2==2.9.1",
    "pytest==9.1.1",
    "ruff==0.16.1",
    "ty==0.0.65",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
target-version = "py314"

[tool.ty.environment]
python-version = "3.14"
