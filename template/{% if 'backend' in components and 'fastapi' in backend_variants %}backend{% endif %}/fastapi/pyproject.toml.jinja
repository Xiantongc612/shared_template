{% from "template/_versions.jinja" import versions -%}
[project]
name = "fastapi-backend"
version = "{{ versions.project }}"
requires-python = ">={{ versions.python }}"
dependencies = [
    "fastapi=={{ versions.fastapi }}",
    "uvicorn=={{ versions.uvicorn }}",
{% if fastapi_pydantic_ai %}    "pydantic-ai=={{ versions.pydantic_ai }}",
{% endif %}]

[dependency-groups]
dev = [
    "httpx2=={{ versions.httpx2 }}",
    "pytest=={{ versions.pytest }}",
    "ruff=={{ versions.ruff }}",
    "ty=={{ versions.ty }}",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
target-version = "py{{ versions.python | replace('.', '') }}"

[tool.ty.environment]
python-version = "{{ versions.python }}"
