{% from "template/_versions.jinja" import versions -%}
FROM ghcr.io/astral-sh/uv:{{ versions.uv }}@{{ versions.uv_image_digest }} AS uv
FROM python:{{ versions.python_image }}@{{ versions.python_image_digest }}

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml ./
RUN uv sync --no-dev

COPY app ./app

EXPOSE 8000
CMD ["/app/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
