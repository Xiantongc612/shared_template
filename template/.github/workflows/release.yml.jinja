{% from "template/_versions.jinja" import versions -%}
---
name: Release

on:
  workflow_run:
    workflows: ["Validate"]
    types: [completed]

permissions:
  contents: read

jobs:
  build:
    if: >-
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.event != 'pull_request'
    runs-on: {{ versions.ubuntu_runner }}
    timeout-minutes: 120
    steps:
      - name: Check out triggering commit
        uses: actions/checkout@{{ versions.checkout_action_sha }} # {{ versions.checkout_action }}
        with:
          ref: {% raw %}${{ github.event.workflow_run.head_sha }}{% endraw %}
          persist-credentials: false
{% if 'backend' in components and 'fastapi' in backend_variants %}
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@{{ versions.buildx_action_sha }} # {{ versions.buildx_action }}
{% endif %}
{% if 'frontend' in components or 'client' in components or ('backend' in components and 'hono' in backend_variants) %}
      - name: Cache Bun downloads
        uses: actions/cache@{{ versions.cache_action_sha }} # {{ versions.cache_action }}
        with:
          path: ~/.bun/install/cache
          key: bun-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-{{ versions.bun }}-{% raw %}${{ hashFiles('**/package.json') }}{% endraw %}
{% endif %}
{% if 'client' in components %}
      - name: Cache Cargo downloads
        uses: actions/cache@{{ versions.cache_action_sha }} # {{ versions.cache_action }}
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
          key: cargo-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-{{ versions.rust }}-{% raw %}${{ hashFiles('client/src-tauri/Cargo.toml') }}{% endraw %}
      - name: Install Tauri system dependencies
        run: >-
          sudo apt-get update && sudo apt-get install -y
          libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev
          libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf libfuse2
{% endif %}
{% if 'backend' in components and 'fastapi' in backend_variants %}
      - name: Cache uv downloads
        uses: actions/cache@{{ versions.cache_action_sha }} # {{ versions.cache_action }}
        with:
          path: ~/.cache/uv
          key: uv-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-{{ versions.python_runtime }}-{{ versions.uv }}-{% raw %}${{ hashFiles('backend/fastapi/pyproject.toml') }}{% endraw %}
{% endif %}
      - name: Install Devbox
        uses: jetify-com/devbox-install-action@{{ versions.devbox_action_sha }} # {{ versions.devbox_action }}
        with:
          enable-cache: true
          devbox-version: {{ versions.devbox_cli }}
          sha256-checksum: {{ versions.devbox_cli_checksum }}
          disable-nix-access-token: true
      - name: Initialize project
        run: devbox run init
      - name: Build project artifacts
{% if 'backend' in components and 'fastapi' in backend_variants %}
        env:
          DOCKER_CACHE_ARGS: --cache-from type=gha,scope=fastapi --cache-to type=gha,mode=max,scope=fastapi
{% endif %}
        run: devbox run build
{% if 'frontend' in components %}
      - name: Archive frontend artifact
        if: startsWith(github.event.workflow_run.head_branch, 'v')
        run: mkdir -p release-artifacts && tar -czf release-artifacts/frontend.tar.gz -C frontend dist
{% endif %}
{% if 'client' in components %}
      - name: Collect client artifacts
        if: startsWith(github.event.workflow_run.head_branch, 'v')
        run: >-
          mkdir -p release-artifacts &&
          cp client/src-tauri/target/release/bundle/deb/*.deb
          client/src-tauri/target/release/bundle/appimage/*.AppImage
          release-artifacts/
{% endif %}
{% if 'backend' in components and 'hono' in backend_variants %}
      - name: Archive Hono artifact
        if: startsWith(github.event.workflow_run.head_branch, 'v')
        run: mkdir -p release-artifacts && tar -czf release-artifacts/hono-worker.tar.gz -C backend/hono dist
{% endif %}
{% if 'backend' in components and 'fastapi' in backend_variants %}
      - name: Collect FastAPI artifact
        if: startsWith(github.event.workflow_run.head_branch, 'v')
        run: mkdir -p release-artifacts && cp backend/fastapi/dist/fastapi-backend.tar release-artifacts/
{% endif %}
      - name: Upload release artifacts
        if: startsWith(github.event.workflow_run.head_branch, 'v')
        uses: actions/upload-artifact@{{ versions.upload_artifact_action_sha }} # {{ versions.upload_artifact_action }}
        with:
          name: release-artifacts
          path: release-artifacts/
          if-no-files-found: error
{% if 'frontend' in components and frontend_variant == 'astro' %}
      - name: Upload Astro deploy artifact
        uses: actions/upload-artifact@{{ versions.upload_artifact_action_sha }} # {{ versions.upload_artifact_action }}
        with:
          name: astro-dist
          path: frontend/dist
          if-no-files-found: error
{% endif %}
{% if 'backend' in components and 'hono' in backend_variants %}
      - name: Upload Hono deploy artifact
        uses: actions/upload-artifact@{{ versions.upload_artifact_action_sha }} # {{ versions.upload_artifact_action }}
        with:
          name: hono-dist
          path: backend/hono/dist
          if-no-files-found: error
{% endif %}

  publish:
    needs: build
    if: startsWith(github.event.workflow_run.head_branch, 'v')
    runs-on: {{ versions.ubuntu_runner }}
    timeout-minutes: 10
    environment: production
    permissions:
      contents: write
    steps:
      - name: Download release artifacts
        uses: actions/download-artifact@{{ versions.download_artifact_action_sha }} # {{ versions.download_artifact_action }}
        with:
          name: release-artifacts
          path: release-artifacts
      - name: Publish GitHub Release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: >-
          gh release create "{% raw %}${{ github.event.workflow_run.head_branch }}{% endraw %}" --generate-notes
          release-artifacts/*
