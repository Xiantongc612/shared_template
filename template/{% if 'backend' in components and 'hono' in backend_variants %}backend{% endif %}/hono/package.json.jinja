{
  "name": "hono-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "release:staging": "wrangler versions upload --env staging --strict --tag $GITHUB_SHA --message $GITHUB_SHA && wrangler versions deploy --env staging --version-tag $GITHUB_SHA --yes",
    "release:production": "wrangler versions upload --env production --strict --tag $GITHUB_SHA --message $GITHUB_SHA && wrangler versions deploy --env production --version-tag $GITHUB_SHA --yes",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "4.12.34"{% if hono_ai_sdk %},
    "ai": "7.0.48",
    "zod": "4.3.6"{% endif %}
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "wrangler": "4.118.0"
  }
}
