{% from "template/_versions.jinja" import versions -%}
terraform {
  required_version = "= {{ versions.opentofu }}"
  backend "s3" {}

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "= {{ versions.cloudflare_provider }}"
    }
  }
}

variable "cloudflare_account_id" {
  type        = string
  description = "Cloudflare account identifier."
}

provider "cloudflare" {}

module "worker" {
  source = "../../modules/worker"

  account_id = var.cloudflare_account_id
  name       = "{{ cloudflare_project_id }}-hono-production"
}
