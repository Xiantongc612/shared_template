{% from "template/_versions.jinja" import versions -%}
{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/{{ versions.devbox_schema }}/.schema/devbox.schema.json",
  "packages": [
    "actionlint@{{ versions.actionlint }}",
    "gitleaks@{{ versions.gitleaks }}",
    "semgrep@{{ versions.semgrep }}",
    "pre-commit@{{ versions.pre_commit }}"{% if ('frontend' in components and frontend_variant == 'astro') or ('backend' in components and 'hono' in backend_variants) %},
    "opentofu@{{ versions.opentofu }}"{% endif %}{% if 'frontend' in components or 'client' in components or ('backend' in components and 'hono' in backend_variants) %},
    "bun@{{ versions.bun }}"{% endif %}{% if 'client' in components %},
    "cargo@{{ versions.rust }}",
    "rustc@{{ versions.rust }}",
    "rustfmt@{{ versions.rust }}",
    "clippy@{{ versions.rust }}"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
    "python@{{ versions.python_runtime }}",
    "uv@{{ versions.uv }}"{% endif %}
  ],
  "shell": {
    "scripts": {
      "init": [
        "pre-commit install"{% if 'frontend' in components %},
        "bun install --cwd frontend"{% endif %}{% if 'client' in components %},
        "bun install --cwd client",
        "test -f client/src-tauri/icons/32x32.png && test -f client/src-tauri/icons/128x128.png && test -f client/src-tauri/icons/128x128@2x.png && test -f client/src-tauri/icons/icon.icns && test -f client/src-tauri/icons/icon.ico || bun run --cwd client tauri icon src-tauri/app-icon.svg"{% endif %}{% if 'backend' in components and 'hono' in backend_variants %},
        "bun install --cwd backend/hono"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
        "uv sync --project backend/fastapi"{% endif %}
      ],
      "fmt": [{% if 'frontend' in components %}
        "bun run --cwd frontend format"{% if frontend_variant == 'astro' or 'client' in components or ('backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants)) %},{% endif %}{% if frontend_variant == 'astro' %}
        "tofu fmt -recursive frontend/infrastructure"{% if 'client' in components or ('backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants)) %},{% endif %}{% endif %}{% endif %}{% if 'client' in components %}
        "bun run --cwd client format",
        "cargo fmt --manifest-path client/src-tauri/Cargo.toml --all"{% if 'backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants) %},{% endif %}{% endif %}{% if 'backend' in components and 'hono' in backend_variants %}
        "bun run --cwd backend/hono format",
        "tofu fmt -recursive backend/hono/infrastructure"{% if 'fastapi' in backend_variants %},{% endif %}{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %}
        "uv run --project backend/fastapi ruff format backend/fastapi"{% endif %}
      ],
      "check": [
        "gitleaks git",
        "semgrep scan --config semgrep.yml",
        "actionlint"{% if 'frontend' in components %},
        "bun run --cwd frontend check"{% if frontend_variant == 'astro' %},
        "tofu fmt -check -recursive frontend/infrastructure",
        "tofu -chdir=frontend/infrastructure/environments/staging init -backend=false",
        "tofu -chdir=frontend/infrastructure/environments/staging validate",
        "tofu -chdir=frontend/infrastructure/environments/production init -backend=false",
        "tofu -chdir=frontend/infrastructure/environments/production validate"{% endif %}{% endif %}{% if 'client' in components %},
        "bun run --cwd client check",
        "cargo fmt --manifest-path client/src-tauri/Cargo.toml --all -- --check",
        "cargo check --manifest-path client/src-tauri/Cargo.toml --all-targets --all-features",
        "cargo clippy --manifest-path client/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings"{% endif %}{% if 'backend' in components and 'hono' in backend_variants %},
        "bun run --cwd backend/hono check",
        "tofu fmt -check -recursive backend/hono/infrastructure",
        "tofu -chdir=backend/hono/infrastructure/environments/staging init -backend=false",
        "tofu -chdir=backend/hono/infrastructure/environments/staging validate",
        "tofu -chdir=backend/hono/infrastructure/environments/production init -backend=false",
        "tofu -chdir=backend/hono/infrastructure/environments/production validate"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
        "uv run --project backend/fastapi ruff check backend/fastapi",
        "uv run --project backend/fastapi ruff format --check backend/fastapi",
        "uv run --project backend/fastapi ty check backend/fastapi/app"{% endif %}
      ],
      "test": [{% if 'frontend' in components and frontend_variant == 'react' %}
        "bun run --cwd frontend test"{% if 'client' in components or ('backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants)) %},{% endif %}{% endif %}{% if 'client' in components %}
        "bun run --cwd client test",
        "cargo test --manifest-path client/src-tauri/Cargo.toml --all-features"{% if 'backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants) %},{% endif %}{% endif %}{% if 'backend' in components and 'hono' in backend_variants %}
        "bun run --cwd backend/hono test"{% if 'fastapi' in backend_variants %},{% endif %}{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %}
        "uv run --project backend/fastapi pytest backend/fastapi"{% endif %}{% if frontend_variant | default('') == 'astro' and 'client' not in components and ('backend' not in components or not backend_variants) %}
        "echo 'No unit tests configured.'"{% endif %}
      ]{% if frontend_playwright | default(false) or client_playwright | default(false) %},
      "test:e2e": [{% if frontend_playwright | default(false) %}
        "bun run --cwd frontend test:e2e"{% if client_playwright | default(false) %},{% endif %}{% endif %}{% if client_playwright | default(false) %}
        "bun run --cwd client test:e2e"{% endif %}
      ]{% endif %},
      "build": [{% if 'frontend' in components %}
        "bun run --cwd frontend build"{% if 'client' in components or ('backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants)) %},{% endif %}{% endif %}{% if 'client' in components %}
        "bun run --cwd client tauri build --bundles deb,appimage"{% if 'backend' in components and ('hono' in backend_variants or 'fastapi' in backend_variants) %},{% endif %}{% endif %}{% if 'backend' in components and 'hono' in backend_variants %}
        "bun run --cwd backend/hono build"{% if 'fastapi' in backend_variants %},{% endif %}{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %}
        "mkdir -p backend/fastapi/dist",
        "docker buildx build ${DOCKER_CACHE_ARGS:-} --output type=oci,dest=backend/fastapi/dist/fastapi-backend.tar backend/fastapi"{% endif %}
      ]
    }
  }
}
