{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "gitleaks@latest",
    "pre-commit@latest"{% if 'frontend' in components or 'client' in components or ('backend' in components and 'hono' in backend_variants) %},
    "bun@latest"{% endif %}{% if 'client' in components %},
    "cargo@latest",
    "rustc@latest"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
    "python@3.14",
    "uv@latest"{% endif %}
  ],
  "shell": {
    "scripts": {
      "init": [
        "pre-commit install"{% if 'frontend' in components %},
        "bun install --cwd frontend"{% endif %}{% if 'client' in components %},
        "bun install --cwd client"{% endif %}{% if 'backend' in components and 'hono' in backend_variants %},
        "bun install --cwd backend/hono"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
        "uv sync --project backend/fastapi"{% endif %}
      ],
      "check": [
        "gitleaks git"{% if 'frontend' in components %},
        "bun run --cwd frontend check"{% if frontend_variant == 'react' %},
        "bun test --cwd frontend",
        "bun run --cwd frontend build"{% else %},
        "bun run --cwd frontend build"{% endif %}{% endif %}{% if 'client' in components %},
        "bun run --cwd client check",
        "bun test --cwd client",
        "bun run --cwd client build"{% endif %}{% if 'backend' in components and 'hono' in backend_variants %},
        "bun run --cwd backend/hono check",
        "bun test --cwd backend/hono",
        "bun run --cwd backend/hono build"{% endif %}{% if 'backend' in components and 'fastapi' in backend_variants %},
        "uv run --project backend/fastapi ruff check backend/fastapi",
        "uv run --project backend/fastapi ruff format --check backend/fastapi",
        "uv run --project backend/fastapi ty check backend/fastapi/app",
        "uv run --project backend/fastapi pytest backend/fastapi"{% endif %}
      ]
    }
  }
}
