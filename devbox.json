{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "uv@0.12.1",
    "gitleaks@8.30.1",
    "pre-commit@4.5.1",
    "bun@1.3.13",
    "actionlint@1.7.12",
    "semgrep@1.164.0"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "init": [
        "uv sync --locked",
        "pre-commit install"
      ],
      "fmt": [
        "uv run --locked ruff format ."
      ],
      "check": [
        "gitleaks git",
        "uv lock --check",
        "semgrep scan --config semgrep.yml",
        "actionlint",
        "uv run --locked ruff check .",
        "uv run --locked ruff format --check .",
        "uv run --locked ty check"
      ],
      "build": [
        "mkdir -p dist",
        "tar -czf dist/template.tar.gz --exclude=.git --exclude=.devbox --exclude=.venv --exclude=.pytest_cache --exclude=.ruff_cache --exclude=__pycache__ ."
      ],
      "test": [
        "uv run --locked pytest"
      ],
      "integration": [
        "uv run --locked python scripts/generated_integration.py all"
      ],
      "integration:react": [
        "uv run --locked python scripts/generated_integration.py react"
      ],
      "integration:react-integrations": [
        "uv run --locked python scripts/generated_integration.py react-integrations"
      ],
      "integration:astro": [
        "uv run --locked python scripts/generated_integration.py astro"
      ],
      "integration:astro-integrations": [
        "uv run --locked python scripts/generated_integration.py astro-integrations"
      ],
      "integration:tauri": [
        "uv run --locked python scripts/generated_integration.py tauri"
      ],
      "integration:tauri-integrations": [
        "uv run --locked python scripts/generated_integration.py tauri-integrations"
      ],
      "integration:tauri-all": [
        "uv run --locked python scripts/generated_integration.py tauri-all"
      ],
      "integration:hono": [
        "uv run --locked python scripts/generated_integration.py hono"
      ],
      "integration:hono-integrations": [
        "uv run --locked python scripts/generated_integration.py hono-integrations"
      ],
      "integration:fastapi": [
        "uv run --locked python scripts/generated_integration.py fastapi"
      ],
      "integration:fastapi-integrations": [
        "uv run --locked python scripts/generated_integration.py fastapi-integrations"
      ]
    }
  }
}
