{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "uv@latest",
    "gitleaks@latest",
    "pre-commit@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "init": [
        "uv sync --locked",
        "pre-commit install"
      ],
      "check": [
        "gitleaks git",
        "uv run ruff check .",
        "uv run ruff format --check .",
        "uv run ty check",
        "uv run pytest"
      ]
    }
  }
}
