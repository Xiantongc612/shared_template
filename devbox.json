{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "uv@latest",
    "gitleaks@latest",
    "pre-commit@latest",
    "bun@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "init": [
        "uv sync --locked",
        "pre-commit install"
      ],
      "check": [
        "gitleaks git",
        "uv run ruff check .",
        "uv run ruff format --check .",
        "uv run ty check",
        "uv run pytest"
      ],
      "integration": [
        "uv run python scripts/generated_integration.py all"
      ],
      "integration:react": [
        "uv run python scripts/generated_integration.py react"
      ],
      "integration:astro": [
        "uv run python scripts/generated_integration.py astro"
      ],
      "integration:tauri": [
        "uv run python scripts/generated_integration.py tauri"
      ],
      "integration:hono": [
        "uv run python scripts/generated_integration.py hono"
      ],
      "integration:fastapi": [
        "uv run python scripts/generated_integration.py fastapi"
      ]
    }
  }
}
